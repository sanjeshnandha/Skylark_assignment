# ─── LLM provider ──────────────────────────────────────────────────────────────
# Set ONE key and you are running. If LLM_PROVIDER is left blank, whichever key
# is present is used, preferring gemini → groq → anthropic.
#
#   gemini     Free tier, no card required — aistudio.google.com/apikey
#   groq       Free tier, very fast        — console.groq.com/keys
#   anthropic  Paid                        — console.anthropic.com
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# gemini-2.5-flash (default) · gemini-2.5-pro · gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
# llama-3.3-70b-versatile (default) · moonshotai/kimi-k2-instruct
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: point a provider at a compatible proxy or alternative host.
# GROQ_BASE_URL also works for any OpenAI-compatible API (Together, OpenRouter,
# a local llama.cpp server).
# GEMINI_BASE_URL=
# GROQ_BASE_URL=
# ANTHROPIC_BASE_URL=

# ─── monday.com ────────────────────────────────────────────────────────────────
# Personal API v2 token: monday.com → avatar → Administration → Connections → API
MONDAY_API_TOKEN=

# Board IDs. Leave blank and the agent will auto-discover them by name on first
# call (results are cached). `npm run import` prints these after it creates them.
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# ─── Runtime ───────────────────────────────────────────────────────────────────
# "live"  → query the real monday.com account (default, and what the assignment requires)
# "mock"  → replay the source spreadsheets through the identical GraphQL-shaped
#           interface. Development and CI only; never used in the hosted demo.
DATA_SOURCE=live

# Optional: protects the hosted demo from strangers burning your API quota.
# Leave blank to disable the gate.
APP_ACCESS_CODE=
